# DSH environment variables — copy to .env and fill in real values.
# .env is gitignored; this template is tracked so the required vars are documented.
#
# Precedence (dsh-credentials-local): inherited env > .credentials.yaml >
# <cwd>/.env > ~/.dsh/.env. A key in .credentials.yaml overrides .env for
# consumers that read through the credentials service (LLM providers); the
# MCP !!js process.env.* expressions see ONLY process.env, so .env (loaded
# into process.env at boot) is the reliable source for those.

# z.ai API key — consumed by:
#   - z-ai LLM provider (settings.yaml: apiKeyEnv)
#   - z.ai MCP servers (cordis.patch.yml: !!js process.env.Z_AI_API_KEY)
Z_AI_API_KEY=

# Gateway API key — consumed by the twister LLM provider (settings.yaml)
GATEWAY_API_KEY=

# DeepSeek API key — consumed by the built-in web_search tool and any
# DeepSeek LLM route. Leave blank if you don't use the DeepSeek provider.
DEEPSEEK_API_KEY=

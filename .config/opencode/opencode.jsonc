{
    "$schema": "https://opencode.ai/config.json",
    "disabled_providers": ["opencode", "zai"],
    "model": "zai-coding-plan/glm-5.3",
    "provider": {
        // Hide specific OpenCode Zen models instead of the whole provider:
        // remove "opencode" from disabled_providers, then uncomment.
        // "opencode": {
        //     "blacklist": ["glm-4.6", "ling-3.0-flash-free"]
        // },
        "Twister": {
           "npm": "@ai-sdk/openai-compatible",
            "name": "llamacpp",
            "options": {
                "baseURL": "http://twister:8008/v1"
            },
            "models": {
                "/models/unsloth/Qwen3.8-27B-GGUF/Qwen3.8-27B-UD-Q6_K.gguf": {
                    "name": "Qwen3.8 27B GGUF UD-Q6_K",
                    "modalities": {
                        "input": ["text", "image"],
                        "output": ["text"]
                    },
                    "attachment": true,
                    "variants": {
                        "thinking": {
                            "chat_template_kwargs": {"enable_thinking": true, "reasoning_effort": "xhigh"}
                        },
                        "medium": {
                            "chat_template_kwargs": {"enable_thinking": true, "reasoning_effort": "medium"}
                        },
                        "low": {
                            "chat_template_kwargs": {"enable_thinking": true, "reasoning_effort": "low"}
                        },
                        "fast": {
                            "chat_template_kwargs": {"enable_thinking": false}
                        }
                    }
                },
            }
        },
        "muse-glimmer": {
            "npm": "@ai-sdk/openai-compatible",
            "name": "Muse Glimmer 30b (Meta)",
            "options": {
                "baseURL": "http://twister:8005/v1"
            },
            "models": {
                "muse-glimmer-30b": {
                    "name": "Muse Glimmer 30b (Meta)",
                    "limit": {
                        "context": 131072,
                        "output": 32768
                    },
                    "modalities": {
                        "input": ["text", "image"],
                        "output": ["text"]
                    },
                    "attachment": true,
                    "variants": {
                        "xhigh": {
                            "chat_template_kwargs": {"reasoning_strength": "xhigh"}
                        },
                        "high": {
                            "chat_template_kwargs": {"reasoning_strength": "high"}
                        },
                        "low": {
                            "chat_template_kwargs": {"reasoning_strength": "low"}
                        }
                    }
                }
            }
        },
        "strata": {
            "npm": "@ai-sdk/openai-compatible",
            "name": "Strata (twister:8018)",
            "options": {
                "baseURL": "http://twister:8018/v1"
            },
            "models": {
                "qwen3.8-flash-next-iq3_s": {
                    "name": "Qwen3.8 Flash Next IQ3_S",
                    "limit": {
                        "context": 262144,
                        "output": 32768
                    },
                    "modalities": {
                        "input": ["text", "image"],
                        "output": ["text"]
                    },
                    "attachment": true,
                    "variants": {
                        "high": {
                            "chat_template_kwargs": {"enable_thinking": true, "reasoning_effort": "high"}
                        },
                        "medium": {
                            "chat_template_kwargs": {"enable_thinking": true, "reasoning_effort": "medium"}
                        },
                        "low": {
                            "chat_template_kwargs": {"enable_thinking": true, "reasoning_effort": "low"}
                        },
                        "fast": {
                            "chat_template_kwargs": {"enable_thinking": false}
                        }
                    }
                }
            }
        }
  },
  "tools": {
      "write": true,
      "bash": true,
      "grep": true,
      "websearch": true,
      "webfetch": true,
  },
    "mcp": {
 	"blender": {
            "enabled": true,
	    "type":"local",
            "environment": {
                "BLENDER_MCP_PORT": "9876"
            },
	    "command": [ "uv", "--directory", "{env:HOME}/src/blender_mcp/mcp", "run", "blender-mcp", "--transport", "stdio"]
	},
        "kirenn": {
            "enabled":false,
            "type": "remote",
            "url": "http://twister:7778/api/mcp"
        },
        "UnrealEngine": {
            "enabled": true,
            "type": "remote",
            "url": "http://localhost:9877/mcp"
        },
        "Rider": {
            "type": "remote",
            "url": "http://127.0.0.1:64482/stream",
            "enabled": true
        },
        "searxng": {
            "enabled": false,
            "type": "local",
            "command": ["npx", "mcp-searxng"],
            "environment": {
                "SEARXNG_URL": "http://twister:8501"
            }
        },
        "z.ai-web-search-prime": {
            "type": "remote",
            "url": "https://api.z.ai/api/mcp/web_search_prime/mcp",
            "headers": {
                "Authorization": "060200bfac7441a18237c391cbbe4641.zKmwDM6EZooQMO9m"
            }
        },
        "z.ai-web-reader": {
            "type": "remote",
            "url": "https://api.z.ai/api/mcp/web_reader/mcp",
            "headers": {
                "Authorization": "060200bfac7441a18237c391cbbe4641.zKmwDM6EZooQMO9m"
            }
        }
  },
  "agent": {
    "plan": {
      "tools": {
        "write": false,
        "bash": false
      }
    },
    "build": {
      "permission": {
        "bash": "allow"
      }
    }
  },
  "plugin": [],
  "permission": {
    "edit": "ask"
  }
}
